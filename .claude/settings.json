{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node .claude/hooks/check-staging-scope.mjs || exit 0",
            "if": "Bash(git *)",
            "statusMessage": "스테이징 범위 확인",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
